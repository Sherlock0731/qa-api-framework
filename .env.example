# Environment Configuration for Docker Compose
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git!

# Environment
ENV=local

# Thread Configuration
THREAD_COUNT=4

# ReqRes API Configuration
REQRES_BASE_URL=https://reqres.in
REQRES_API_KEY=your_reqres_api_key_here

# Beeceptor API Configuration
BEECEPTOR_BASE_URL=https://your-endpoint.free.beeceptor.com

# Test User Credentials
TEST_USER_EMAIL=your_test_email@example.com
TEST_USER_PASSWORD=your_test_password
TEST_USER_FIRSTNAME=YourFirstName
TEST_USER_LASTNAME=YourLastName
TEST_USER_ID=1

# Test Groups (optional, comma-separated)
# TEST_GROUPS=smoke,regression
